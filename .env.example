# ── Google Vertex AI (required) ───────────────────────────────────────────────
# Your GCP project ID — find it in the Cloud Console header
VERTEX_PROJECT=your-gcp-project-id

# Region where Claude is enabled in Vertex AI Model Garden.
# Claude Opus 4.7 is available at: global, us-east5, europe-west1, asia-southeast1
VERTEX_LOCATION=us-east5

# Region for the fast (Haiku) model. Defaults to VERTEX_LOCATION if unset.
# Set this when VERTEX_LOCATION=global, since Claude Haiku 4.5 is regional-only
# (us-east5, europe-west4, asia-southeast1) and 404s on the global endpoint.
VERTEX_FAST_LOCATION=us-east5

# ── Model config ───────────────────────────────────────────────────────────────
LLM_MODEL=claude-opus-4-7
LLM_FAST_MODEL=claude-haiku-4-5@20251001
LLM_TEMPERATURE=0.1

# ── Authentication ─────────────────────────────────────────────────────────────
# Option 1 (local dev):  gcloud auth application-default login
# Option 2 (CI/server):  GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json
# Service account needs role: roles/aiplatform.user

# ── Vector Store ───────────────────────────────────────────────────────────────
CHROMA_PERSIST_PATH=./data/chroma_db

# ── Embeddings ─────────────────────────────────────────────────────────────────
# a) OpenAI (fast): set key below
# b) Local fallback: leave blank — uses sentence-transformers/all-MiniLM-L6-v2
OPENAI_API_KEY=

# ── Gmail OAuth (optional) ────────────────────────────────────────────────────
GMAIL_CREDENTIALS_PATH=./credentials.json
GMAIL_TOKEN_PATH=./data/gmail_token.json

# ── Observability (optional) ──────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=finance-coach-agent

# ── App ────────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
